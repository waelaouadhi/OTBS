<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E0E0E0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/jobTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/kode_mono"
            android:textColor="#1E88E5"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/jobDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:lineSpacingExtra="4dp"
            android:textColor="#424242"
            android:textSize="14sp" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:orientation="horizontal"
            android:weightSum="5">

            <!-- Primary action: View Details -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewDetails"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:textColor="#1E88E5"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:contentDescription="View details"
                android:textAllCaps="false"
                app:icon="@drawable/baseline_list_alt_24"
                app:iconGravity="textStart"
                app:iconPadding="4dp" />

            <!-- Applicants list -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplicants"
                android:layout_weight="1"
                android:minWidth="0dp"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:contentDescription="Applicants"
                android:textAllCaps="false"
                app:icon="@drawable/baseline_people_24"
                app:iconGravity="textStart"
                app:iconPadding="4dp" />

            <!-- Edit -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdate"
                android:layout_weight="1"
                android:minWidth="0dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:contentDescription="Edit"
                android:textAllCaps="false"
                app:icon="@drawable/baseline_edit_24"
                app:iconGravity="textStart"
                app:iconPadding="4dp" />

            <!-- Finish -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFinish"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:backgroundTint="#4CAF50"
                android:textColor="@color/white"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:contentDescription="Mark as finished"
                android:textAllCaps="false"
                app:icon="@drawable/baseline_check_circle_24"
                app:iconGravity="textStart"
                app:iconPadding="4dp" />

            <!-- Delete -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                android:layout_weight="1"
                android:minWidth="0dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Delete"
                android:textAllCaps="false"
                android:textColor="#D32F2F"
                app:icon="@drawable/baseline_delete_24"
                app:iconTint="#D32F2F"
                app:strokeColor="#D32F2F"
                app:iconGravity="textStart"
                app:iconPadding="4dp" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>