<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".TrainingFragment">

    <!-- Title -->
    <EditText
        android:id="@+id/trainingNameEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Training Title"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Description -->
    <EditText
        android:id="@+id/trainingDescriptionEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Training Description"
        app:layout_constraintTop_toBottomOf="@id/trainingNameEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- Department -->
    <EditText
        android:id="@+id/departmentEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Department"
        app:layout_constraintTop_toBottomOf="@id/trainingDescriptionEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- Date Range Selector -->
    <Button
        android:id="@+id/selectDateRangeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Date Range"
        app:layout_constraintTop_toBottomOf="@id/departmentEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <!-- Submit -->
    <Button
        android:id="@+id/submitTrainingButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Submit Training"
        app:layout_constraintTop_toBottomOf="@id/selectDateRangeButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>