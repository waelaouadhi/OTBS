<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_primary"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/md_theme_primary"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/add_training"
            app:titleTextColor="@color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/md_theme_background"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Content starts here -->

            <!-- Training Title -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/titleInputLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/training_title"
                app:boxBackgroundColor="@color/md_theme_surface"
                app:shapeAppearanceOverlay="@style/RoundedCorners"
                app:boxStrokeColor="@color/md_theme_primary"
                app:endIconMode="clear_text"
                app:hintTextColor="@color/md_theme_onSurfaceVariant"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/trainingNameEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:textColor="@color/md_theme_onBackground"
                    android:textColorHint="@color/md_theme_onSurfaceVariant" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Training Description -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/descriptionInputLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/training_description"
                app:boxBackgroundColor="@color/md_theme_surface"
                app:shapeAppearanceOverlay="@style/RoundedCorners"
                app:boxStrokeColor="@color/md_theme_primary"
                app:hintTextColor="@color/md_theme_onSurfaceVariant"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titleInputLayout">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/trainingDescriptionEditText"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="4"
                    android:paddingTop="12dp"
                    android:textColor="@color/md_theme_onBackground"
                    android:textColorHint="@color/md_theme_onSurfaceVariant" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Department -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/departmentInputLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/department"
                app:boxBackgroundColor="@color/md_theme_surface"
                app:boxStrokeColor="@color/md_theme_primary"
                app:endIconMode="dropdown_menu"
                app:hintTextColor="@color/md_theme_onSurfaceVariant"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/descriptionInputLayout"
                app:shapeAppearanceOverlay="@style/RoundedCorners">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/departmentEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:paddingTop="12dp"
                    android:textColor="@color/md_theme_onBackground"
                    android:textColorHint="@color/md_theme_onSurfaceVariant" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Date Range Selector -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectDateRangeButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="63dp"
                android:layout_marginTop="24dp"
                android:drawablePadding="8dp"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:text="@string/select_date_range"
                android:textAllCaps="false"
                android:textColor="@color/md_theme_primary"
                android:textSize="16sp"
                app:cornerRadius="8dp"
                app:iconGravity="textStart"
                app:iconTint="@color/md_theme_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/departmentInputLayout"
                app:rippleColor="@color/md_theme_primaryContainer"
                app:strokeColor="@color/md_theme_outline"
                app:strokeWidth="1dp" />

            <!-- Date Range Text -->
            <TextView
                android:id="@+id/dateRangeText"
                style="@style/TextAppearance.MaterialComponents.Caption"
                android:layout_width="0dp"
                android:layout_height="18dp"
                android:layout_marginTop="4dp"
                android:paddingStart="16dp"
                android:textColor="@color/md_theme_onSurfaceVariant"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/selectDateRangeButton"
                tools:text="No date range selected" />

            <!-- Submit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/submitTrainingButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="@color/md_theme_primary"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:text="@string/submit_training"
                android:textAllCaps="false"
                android:textColor="@color/md_theme_onPrimary"
                android:textSize="16sp"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/md_theme_onPrimary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dateRangeText"
                app:rippleColor="@color/md_theme_primaryContainer" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>