<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/doctorNameLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Doctor Name"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/black"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editDoctorName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/textView5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Please choose date For doctor visit"
            android:textColor="#030A23"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/doctorNameLayout" />

        <com.github.sundeepk.compactcalendarview.CompactCalendarView
            android:id="@+id/compactCalendarView"
            android:layout_width="333dp"
            android:layout_height="296dp"
            android:layout_marginTop="16dp"
            app:ccv_bg_color="@color/calendar_bg"
            app:ccv_current_day_background_color="@color/colorAccent"
            app:ccv_current_day_text_color="@color/current_day_text"
            app:ccv_month_text_color="@color/month_text_color"
            app:ccv_selected_day_background_color="@color/selected_day_bg"
            app:ccv_selected_day_text_color="@color/selected_day_text"
            app:ccv_text_color="@color/calendar_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView5" />

        <TextView
            android:id="@+id/textView10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Not selected"
            android:textColor="#FD5B00"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/compactCalendarView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- New TextView indicating Doctor Visit -->
        <TextView
            android:id="@+id/doctorVisitText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reserved for doctor visit."
            android:textColor="#FD5B00"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/textView10"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Orange Circle Tag (Initially hidden) -->
        <View
            android:id="@+id/dateTag"
            android:layout_width="69dp"
            android:layout_height="51dp"
            android:background="@drawable/orange_circle"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/doctorVisitText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageButton
            android:id="@+id/submitbtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="submit"
            android:src="@drawable/submit"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.497"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView10"
            app:layout_constraintVertical_bias="0.869" />

        <EditText
            android:id="@+id/editStartTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Start Time"
            android:inputType="time"
            android:padding="10dp"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:importantForAccessibility="yes"
            android:contentDescription="Start time input field"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:imeOptions="actionDone"
            app:layout_constraintTop_toBottomOf="@id/doctorVisitText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/editEndTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="End Time"
            android:inputType="time"
            android:padding="10dp"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:importantForAccessibility="yes"
            android:contentDescription="End time input field"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:imeOptions="actionDone"
            app:layout_constraintTop_toBottomOf="@id/editStartTime"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>