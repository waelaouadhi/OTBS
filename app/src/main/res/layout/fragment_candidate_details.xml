<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Candidate Details" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardUseCompatPadding="true"
                app:strokeWidth="1dp"
                app:strokeColor="@color/md_theme_onSurfaceVariant"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:textColor="@color/md_theme_onBackground"/>

                    <TextView
                        android:id="@+id/role"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:text="Role"/>

                    <TextView
                        android:id="@+id/email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/md_theme_onSurfaceVariant"/>

                    <TextView
                        android:id="@+id/resume"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Resume: uploaded"
                        android:textColor="@color/md_theme_onSurfaceVariant"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Overall Match Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardUseCompatPadding="true"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/overallScoreIndicator"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        app:indicatorSize="8dp"
                        app:trackThickness="8dp"
                        app:indicatorInset="4dp"
                        app:trackColor="@color/md_theme_primaryContainer"
                        app:indicatorColor="@color/md_theme_primary"
                        android:progress="0"
                        android:max="100"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="16dp">

                        <TextView
                            android:id="@+id/score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/md_theme_onBackground"
                            android:text="-"/>

                        <TextView
                            android:id="@+id/interpretationText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/md_theme_onSurfaceVariant"
                            android:text=""/>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnComputeScore"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Compute AI Score"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section Breakdown Card (collapsible) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/breakdownHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Match breakdown"
                        android:textStyle="bold"
                        android:paddingBottom="8dp"
                        android:textColor="@color/md_theme_onBackground"/>

                    <LinearLayout
                        android:id="@+id/breakdownContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Skills row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:id="@+id/skillsScoreLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Skills"
                                android:textColor="@color/md_theme_onSurfaceVariant"/>
                            <TextView
                                android:id="@+id/skillsPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textColor="@color/md_theme_onSurfaceVariant"/>
                        </LinearLayout>
                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/skillsScoreBar"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:progress="0"
                            android:max="100"
                            app:trackColor="@color/md_theme_primaryContainer"
                            app:indicatorColor="@color/md_theme_primary"/>

                        <!-- Experience row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:id="@+id/experienceScoreLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Experience"
                                android:textColor="@color/md_theme_onSurfaceVariant"/>
                            <TextView
                                android:id="@+id/experiencePercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textColor="@color/md_theme_onSurfaceVariant"/>
                        </LinearLayout>
                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/experienceScoreBar"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:progress="0"
                            android:max="100"
                            app:trackColor="@color/md_theme_primaryContainer"
                            app:indicatorColor="@color/md_theme_primary"/>

                        <!-- Education row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:id="@+id/educationScoreLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Education"
                                android:textColor="@color/md_theme_onSurfaceVariant"/>
                            <TextView
                                android:id="@+id/educationPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textColor="@color/md_theme_onSurfaceVariant"/>
                        </LinearLayout>
                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/educationScoreBar"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:progress="0"
                            android:max="100"
                            app:trackColor="@color/md_theme_primaryContainer"
                            app:indicatorColor="@color/md_theme_primary"/>

                        <!-- Certifications row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:id="@+id/certificationsScoreLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Certifications"
                                android:textColor="@color/md_theme_onSurfaceVariant"/>
                            <TextView
                                android:id="@+id/certificationsPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textColor="@color/md_theme_onSurfaceVariant"/>
                        </LinearLayout>
                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/certificationsScoreBar"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:progress="0"
                            android:max="100"
                            app:trackColor="@color/md_theme_primaryContainer"
                            app:indicatorColor="@color/md_theme_primary"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Skills match Card (collapsible) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/skillsHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Skills match"
                        android:textStyle="bold"
                        android:paddingBottom="8dp"
                        android:textColor="@color/md_theme_onBackground"/>

                    <LinearLayout
                        android:id="@+id/skillsContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Matched"
                            android:textColor="@color/md_theme_onSurfaceVariant"/>
                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/matchedSkillsGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:singleLine="false"
                            app:chipSpacingHorizontal="8dp"
                            app:chipSpacingVertical="8dp"/>
                        <TextView
                            android:id="@+id/matchedEmpty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No matched skills yet"
                            android:visibility="gone"
                            android:textColor="@color/md_theme_onSurfaceVariant"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Missing"
                            android:textColor="@color/md_theme_onSurfaceVariant"/>
                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/missingSkillsGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:singleLine="false"
                            app:chipSpacingHorizontal="8dp"
                            app:chipSpacingVertical="8dp"/>
                        <TextView
                            android:id="@+id/missingEmpty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No missing skills — great match!"
                            android:visibility="gone"
                            android:textColor="@color/md_theme_onSurfaceVariant"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Red Flags Card (collapsible) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/redFlagsHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Red flags"
                        android:textStyle="bold"
                        android:paddingBottom="8dp"
                        android:textColor="@color/md_theme_onBackground"/>

                    <LinearLayout
                        android:id="@+id/redFlagsContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/redFlagsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"/>
                        <TextView
                            android:id="@+id/redFlagsEmpty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No red flags detected"
                            android:visibility="gone"
                            android:textColor="@color/md_theme_onSurfaceVariant"/>

                        <!-- Actions: Download CV, Email, Call -->
                        <LinearLayout
                            android:id="@+id/contactActionsRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDownloadCv"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Download CV" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnEmail"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="Email" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCall"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="Call" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <ProgressBar
                android:id="@+id/progressBar"
                style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginTop="16dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
