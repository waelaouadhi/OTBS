<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/notificationFragment">

    <!-- NotificationFragment definition -->
    <fragment
        android:id="@+id/notificationFragment"
        android:name="com.example.onetechbs.NotificationFragment"
        android:label="Notifications"
        tools:layout="@layout/fragment_notification">

        <!-- Action to navigate to LeaveDetailsFragment -->
        <action
            android:id="@+id/action_notificationFragment_to_leaveDetailsFragment"
            app:destination="@id/leaveDetailsFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim">
            <argument
                android:name="leaveId"
                app:argType="string" />
        </action>

        <!-- Action to navigate to MedicalVisitFragment -->
        <action
            android:id="@+id/action_notificationFragment_to_medicalVisitFragment"
            app:destination="@id/medicalVisitFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim">
            <argument
                android:name="visitId"
                app:argType="string" />
        </action>

        <!-- Action to navigate to TrainingFragment -->
        <action
            android:id="@+id/action_notificationFragment_to_trainingFragment"
            app:destination="@id/trainingFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim">
            <argument
                android:name="trainingId"
                app:argType="string" />
        </action>
    </fragment>

    <!-- Target fragment definitions (placeholders) -->
    <fragment
        android:id="@+id/leaveDetailsFragment"
        android:name="com.example.onetechbs.LeaveDetailsFragment"
        android:label="Leave Details"
        tools:layout="@layout/fragment_leave_details" />

    <fragment
        android:id="@+id/medicalVisitFragment"
        android:name="com.example.onetechbs.MedicalVisitFragment"
        android:label="Medical Visit"
        tools:layout="@layout/fragment_medical_visit" />

    <fragment
        android:id="@+id/trainingFragment"
        android:name="com.example.onetechbs.TrainingFragment"
        android:label="Training"
        tools:layout="@layout/fragment_training" />
    <fragment
        android:id="@+id/doctorListFragment"
        android:name="com.example.onetechbs.DoctorListFragment"
        android:label="Doctors"
        tools:layout="@layout/fragment_doctor_list" >
        <action
            android:id="@+id/action_doctorListFragment_to_homefraFragment"
            app:destination="@id/homefraFragment" />
    </fragment>
    <fragment
        android:id="@+id/homefraFragment"
        android:name="com.example.onetechbs.Homefra"
        android:label="Home"
        tools:layout="@layout/fragment_homefra">
        <action
            android:id="@+id/action_homefraFragment_to_leaveListFragment"
            app:destination="@id/leaveListFragment" />
        <action
            android:id="@+id/action_homefraFragment_to_addLeaveFragment"
            app:destination="@id/addLeaveFragment" />
    </fragment>

    <fragment
        android:id="@+id/leaveListFragment"
        android:name="com.example.onetechbs.LeaveListFragment"
        android:label="Leave List"
        tools:layout="@layout/fragment_leave_list" />

    <fragment
        android:id="@+id/addLeaveFragment"
        android:name="com.example.onetechbs.AddLeaveFragment"
        android:label="Add Leave"
        tools:layout="@layout/fragment_add_leave" />

    <!-- Job Offer Creation Workflow -->
    <fragment
        android:id="@+id/detailsFragment"
        android:name="com.example.onetechbs.DetailsFragment"
        android:label="Job Details"
        tools:layout="@layout/fragment_job_details">
        <action
            android:id="@+id/action_detailsFragment_to_descriptionFragment"
            app:destination="@id/descriptionFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/descriptionFragment"
        android:name="com.example.onetechbs.DescriptionFragment"
        android:label="Job Description"
        tools:layout="@layout/fragment_job_description">
        <action
            android:id="@+id/action_descriptionFragment_to_evaluationFragment"
            app:destination="@id/evaluationFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/evaluationFragment"
        android:name="com.example.onetechbs.EvaluationFragment"
        android:label="Evaluation Criteria"
        tools:layout="@layout/fragment_evaluation">
        <action
            android:id="@+id/action_evaluationFragment_to_reviewFragment"
            app:destination="@id/reviewFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/reviewFragment"
        android:name="com.example.onetechbs.ReviewFragment"
        android:label="Review &amp; Submit"
        tools:layout="@layout/fragment_review" />
</navigation>